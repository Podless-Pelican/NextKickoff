generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Competition {
  id         Int      @id @default(autoincrement())
  source     String
  externalId String
  code       String   @unique
  name       String
  area       String
  type       String   @default("LEAGUE")
  scope      String   @default("DOMESTIC")
  emblem     String?
  isSelected Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  teams      Team[]
  matches    Match[]

  @@unique([source, externalId])
  @@index([scope, name])
}

model Team {
  id            Int          @id @default(autoincrement())
  slug          String       @unique
  aliases       String[]     @default([])
  name          String
  country       String?
  shortName     String?
  tla           String?
  crest         String?
  isSelected    Boolean      @default(false)
  competitionId Int?
  updatedAt     DateTime     @updatedAt
  competition   Competition? @relation(fields: [competitionId], references: [id])
  homeMatches   Match[]      @relation("HomeTeam")
  awayMatches   Match[]      @relation("AwayTeam")

  @@index([competitionId, name])
}

model Match {
  id            Int         @id @default(autoincrement())
  source        String
  externalId    String
  utcDate       DateTime
  status        String
  stage         String?
  matchday      Int?
  competitionId Int
  homeTeamId    Int
  awayTeamId    Int
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([utcDate])
  @@index([competitionId, utcDate])
  @@index([homeTeamId, utcDate])
  @@index([awayTeamId, utcDate])
}

model SyncRun {
  source      String   @id
  completedAt DateTime
  matchCount  Int      @default(0)
  teamCount   Int      @default(0)
}
